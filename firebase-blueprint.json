{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences for KIKO AI language, voice, and AI provider configuration.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated user UID" },
        "preferredLanguage": { "type": "string", "enum": ["auto", "en", "ur"] },
        "aiProvider": { "type": "string", "enum": ["GEMINI", "OPENAI_BACKEND", "CUSTOM_BACKEND", "OFFLINE"] },
        "backendEndpoint": { "type": "string", "description": "Optional backend proxy URL" },
        "backendModel": { "type": "string", "description": "Configured model identifier" },
        "voicePitch": { "type": "number" },
        "voiceRate": { "type": "number" },
        "continuousVoice": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "preferredLanguage", "aiProvider", "backendEndpoint", "backendModel", "voicePitch", "voiceRate", "continuousVoice", "createdAt", "updatedAt"]
    },
    "MemoryEntry": {
      "title": "MemoryEntry",
      "description": "User-approved personal memory and context item for KIKO AI.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string", "enum": ["FACT", "PREFERENCE", "PROJECT", "CONTACT", "PROTOCOL"] },
        "pinned": { "type": "boolean" },
        "source": { "type": "string", "enum": ["USER", "AI_APPROVED"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["title", "content", "category", "pinned", "source", "createdAt", "updatedAt"]
    },
    "SmartReminder": {
      "title": "SmartReminder",
      "description": "Smart reminder or automation routine owned by the user.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "dueLabel": { "type": "string" },
        "priority": { "type": "string", "enum": ["LOW", "NORMAL", "HIGH", "CRITICAL"] },
        "triggerType": { "type": "string", "enum": ["REMINDER", "ROUTINE", "AUTOMATION"] },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["title", "notes", "dueLabel", "priority", "triggerType", "completed", "createdAt", "updatedAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Immutable activity audit log for KIKO AI commands, team dispatches, and device actions.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "teamId": { "type": "string" },
        "status": { "type": "string", "enum": ["COMPLETED", "PENDING", "ALERT", "OFFLINE"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["title", "detail", "teamId", "status", "createdAt"]
    },
    "ChatRecord": {
      "title": "ChatRecord",
      "description": "Persisted conversation turn between the user and KIKO AI.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["USER", "KIKO", "SYSTEM"] },
        "text": { "type": "string" },
        "teamId": { "type": "string" },
        "language": { "type": "string", "enum": ["en", "ur", "auto"] },
        "provider": { "type": "string" },
        "codeSnippet": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["role", "text", "teamId", "language", "provider", "createdAt"]
    },
    "DevProposal": {
      "title": "DevProposal",
      "description": "Autonomous development proposal generated by KIKO Development Team awaiting explicit user approval.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "moduleName": { "type": "string" },
        "summary": { "type": "string" },
        "codePreview": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING_APPROVAL", "APPROVED", "REJECTED"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["title", "moduleName", "summary", "codePreview", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User preferences and AI provider configuration."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/MemoryEntry" },
      "description": "User-scoped personal memory bank."
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/SmartReminder" },
      "description": "User-scoped smart reminders and automation routines."
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "User-scoped activity and notification history."
    },
    "/users/{userId}/chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatRecord" },
      "description": "User-scoped KIKO AI conversation logs."
    },
    "/users/{userId}/dev_proposals/{proposalId}": {
      "schema": { "$ref": "#/entities/DevProposal" },
      "description": "User-scoped autonomous development proposals with approval gate."
    }
  }
}
