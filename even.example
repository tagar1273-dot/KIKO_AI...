
# =====================================
# KIKO AI - ENVIRONMENT CONFIGURATION
# =====================================

# Application
APP_NAME=KIKO AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# AI Provider
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your _GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Optional)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o

# Authentication
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=86400

# Database
DATABASE_URL=SUPABASE_URL=https://obtefmewwbgmqqxiibcw.supabase.co

# Voice Assistant
VOICE_ENABLED=true
VOICE_LANGUAGE=auto
VOICE_RECOGNITION=true
VOICE_RESPONSE=true

# Image Generation
IMAGE_GENERATION_ENABLED=true

# File Upload
MAX_UPLOAD_SIZE=10485760

# Logging
LOG_LEVEL=INFO

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
